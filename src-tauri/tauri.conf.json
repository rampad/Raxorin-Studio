{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raxorin Studio",
  "version": "0.5.0",
  "identifier": "dev.raxorinstudio.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raxorin Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "IDE para crear programas en Rust de forma fácil",
    "longDescription": "Raxorin Studio es un entorno de desarrollo para Rust inspirado en Visual Studio: editor con autocompletado (rust-analyzer), diseñador visual de ventanas (Slint), depurador, gestor de paquetes y soluciones con varios proyectos.",
    "copyright": "© 2026 Benjamin · Licencia MIT",
    "fileAssociations": [
      {
        "ext": [
          "rxsln"
        ],
        "name": "Solución de Raxorin Studio",
        "description": "Solución de Raxorin Studio (varios proyectos de Rust)",
        "role": "Editor",
        "mimeType": "application/x-raxorin-solution",
        "exportedType": {
          "identifier": "dev.raxorinstudio.solution",
          "conformsTo": [
            "public.plain-text"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/fondo.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 150,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 510,
          "y": 215
        }
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0OTNFOTZBNTY4NkM0OEMKUldTTXhJWldhdW1UbE9Ja1pIOW9GcE5YeXJ4NzAxTS9wdzFvKyszZ3JRV3RWWXBBTk11VExFWHcK",
      "endpoints": [
        "https://github.com/rampad/Raxorin-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
