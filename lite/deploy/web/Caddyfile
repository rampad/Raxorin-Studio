# Raxorin Studio Lite (app.raxorin.dev). Solo HTTP interno: el proxy de entrada del servidor (/opt/edge) termina
# el HTTPS detrás de Cloudflare.
{
	admin off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}

	# Archivos con huella (Vite): caché larga. El intérprete de Slint cambia solo con su versión. La página: revalidar.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /slint/* Cache-Control "public, max-age=604800"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Es una sola página: cualquier ruta muestra la app.
	try_files {path} /index.html
	file_server
}
